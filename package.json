{
  "name": "elysia-demo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "dev:native": "pnpm --filter native dev",
    "dev:web": "pnpm --filter web dev",
    "db:push": "pnpm --filter @elysia-demo/db db:push",
    "db:studio": "pnpm --filter @elysia-demo/db db:studio",
    "db:generate": "pnpm --filter @elysia-demo/db db:generate",
    "db:migrate": "pnpm --filter @elysia-demo/db db:migrate",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@elysia-demo/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@elysia-demo/config": "workspace:*",
    "@types/node": "^22.13.14",
    "typescript": "catalog:",
    "ultracite": "7.1.1"
  },
  "packageManager": "pnpm@10.28.2"
}
